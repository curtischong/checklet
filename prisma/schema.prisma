// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

enum AccessType {
    PRIVATE
    HIDDEN // anyone can see the checker, but it won't show up in public checker lists
    PUBLIC
}

model Checker {
    // id        String      @id  @db.Uuid @default(uuid())
    id         String     @id @default(uuid()) @db.Uuid
    name       String     @default("")
    desc       String     @default("")
    prompt     String     @default("")
    sampleDoc  String     @default("") // ppl will use this when developing their checkers. I thihnk I'l also auto-populate the checker with this sample doc when ppl go to the checker?
    accessType AccessType @default(PRIVATE)

    isValid      Boolean @default(false) // has all of the required fields been filled out? if it's not valid, it cannot be public even if they want it to be
    clonedFromId String? @db.Uuid // if this checker was cloned from another checker, this is the id of the original checker
    // promptHashThatDerivedRefinedPrompt Int     @default(0)
    // refinedPrompt                      String  @default("")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    createdById String // firebase Ids are strings

    @@index([name]) // speed up queries that filter or sort by the name field
}

model User {
    id         String   @id // string since we're using firebase auth and their IDs are strings
    email      String   @unique
    // I'll comment this out for now, since it's super easy for us to get the isVerified data. it's just from the firebase token
    // isEmailVerified Boolean? // Note: I think if they reset their password, firebase sends them an email and if they click on the link, they WILL be verified. we need to figure out some way to handle this
    checkerIds String[] @db.Uuid
    createdAt  DateTime @default(now())
}

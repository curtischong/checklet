// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

model Checker {
    // id        String      @id  @db.Uuid @default(uuid())
    id        String      @id @default(uuid())
    name      String
    desc      String
    prompt    String
    isPublic  Boolean     @default(false)
    isValid   Boolean     @default(false) // has all of the required fields been filled out? if it's not valid, it cannot be public even if they want it to be

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    createdById String // firebase Ids are strings

    @@index([name]) // speed up queries that filter or sort by the name field
}

{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES6",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "isolatedModules": true,
    // "strictNullChecks": false,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["../src/*"],
      "@public/*": ["../public/*"]
    }
  }
}
